{
  "name": "shop-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --open",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@shop/api-client": "workspace:*",
    "@shop/types": "workspace:*",
    "@shop/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.21.2",
    "@module-federation/rsbuild-plugin": "^0.21.2",
    "@rsbuild/core": "^1.6.0",
    "@rsbuild/plugin-react": "^1.4.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "zephyr-rsbuild-plugin": "latest"
  },
  "zephyr:dependencies": {
    "catalog": "shop-catalog@*",
    "product": "shop-product@*",
    "cart": "shop-cart@*"
  },
  "nx": {
    "tags": [
      "type:host"
    ],
    "implicitDependencies": [
      "shop-catalog",
      "shop-product",
      "shop-cart"
    ],
    "targets": {
      "build": {
        "cache": false
      }
    }
  }
}
