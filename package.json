{
  "name": "shop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Micro-frontend storefront (React 19 + Rsbuild + Module Federation) with a Fastify API, managed by Nx, deployed with Zephyr Cloud",
  "scripts": {
    "dev": "nx run-many -t dev --parallel=6 --outputStyle=stream",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "dev:stop": "lsof -ti tcp:2000,3001,3002,3003,4000 | xargs -r kill || true"
  },
  "devDependencies": {
    "nx": "^21.6.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
